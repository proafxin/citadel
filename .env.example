# Copy to .env and fill in real values. Do NOT commit .env (it is gitignored).

# Host port mapped to the MinerU API container (mineru-api REST endpoint)
CITADEL_MINERU_PORT=8099

# Host port mapped to the Redis container (container always listens on 6379)
CITADEL_REDIS_PORT=6379

# Hugging Face access token for pulling models (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED. Stable per-replica worker id → deterministic Redis consumer names.
# Must be DISTINCT per worker replica (no default on purpose: a shared id makes
# replicas steal each other's in-flight jobs). Single-host demo can use 0.
CITADEL_WORKER_ID=0

CITADEL_POSTGRES_USER=postgres
CITADEL_POSTGRES_PASSWORD=postgres
CITADEL_POSTGRES_DB=citadel
CITADEL_POSTGRES_PORT=5432
