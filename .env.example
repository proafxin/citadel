# Copy to .env and fill in real values. Do NOT commit .env (it is gitignored).

# Port the vLLM OpenAI-compatible server listens on (host + container)
CITADEL_VLLM_PORT=8099

# Hugging Face access token for pulling models (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
